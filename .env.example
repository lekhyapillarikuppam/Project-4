# Copy this file to .env and fill in the values. Never commit .env.

# Neon Postgres connection string (Neon dashboard → Connection details → Pooled connection)
DATABASE_URL=

# Groq API key (console.groq.com → API Keys)
GROQ_API_KEY=

# OpenRouteService API key (openrouteservice.org → Dashboard → Tokens)
ORS_API_KEY=

# OpenTripMap API key (dev.opentripmap.org → Get API key)
OPENTRIPMAP_API_KEY=

# Long random string used to sign login tokens.
# Generate in PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=

# Frontend URL allowed by CORS (local default shown)
FRONTEND_ORIGIN=http://localhost:5173
